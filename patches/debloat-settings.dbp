
name = "debloat-settings"
description = "Remove ZUI Settings extras."

[[op]]
kind = "method_const_int"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/homepage/controller/TopLevelLenovoAccountPreferenceController;"
method = "getAvailabilityStatus"
value = 3

[[op]]
kind = "preference_controller_hide"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/privacy/UserExperienceSwitchController;"
preference_key = "user_experience"
preference_field = "mUserExperience"

[[op]]
kind = "method_const_bool"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/suggestion/UserExperienceSuggestionActivity;"
method = "isSuggestionComplete"
proto = "(Landroid/content/Context;)Z"
value = true

# Battery health / charge-cycle rows only appear in the Charging optimization
# screen when !isInception() && isRowVersion(); force the gate open.
[[op]]
kind = "method_const_bool"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/battery/ZuiChargingOptimization;"
method = "isSupportBatteryHealthAndCycles"
proto = "()Z"
value = true

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/suggestion/UserExperienceSuggestionActivity;"
method = "onCreate"
proto = "(Landroid/os/Bundle;)V"

[[op.symbol]]
name = "show_dialog"
kind = "method"
class = "Lcom/lenovo/common/utils/LenovoUtils;"
method = "showJoinUserExperienceDialog"
proto = "(Landroid/content/Context;Ljava/lang/Runnable;Ljava/lang/Runnable;Ljava/lang/Runnable;Z)V"

[[op.symbol]]
name = "finish"
kind = "method"
class = "Landroid/app/Activity;"
method = "finish"
proto = "()V"

[[op.replacement]]
from = "71 54 ${show_dialog:u16} 03 21"
to = "6e 10 ${finish:u16} 03 00"

[[op]]
kind = "method_code_redirect"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/privacy/UserExperienceSwitchController;"
method = "getAvailabilityStatus"
proto = "()I"
donor_class = "Lcom/lenovo/settings/widget/UnsupportedPreferenceController;"
donor_method = "getAvailabilityStatus"
donor_proto = "()I"

[[op]]
kind = "method_code_redirect"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/privacy/UserExperienceSwitchController;"
method = "getAvailabilityStatus"
proto = "()I"
donor_class = "Lcom/google/android/material/sidesheet/SideSheetDialog;"
donor_method = "getStateOnStart"
donor_proto = "()I"

[[op]]
kind = "method_const_int"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/android/settings/accounts/TopLevelAccountEntryPreferenceController;"
method = "getAvailabilityStatus"
value = 0

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
scan_class = "Lcom/lenovo/settings/deviceinfo/controller/LenovoServicePreferenceController;"
target_class = "Lcom/lenovo/common/utils/LenovoUtils;"
target_method = "isPrcVersion"
value = false

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
scan_class = "Lcom/lenovo/settings/deviceinfo/controller/LenovoServicePreferenceController;"
target_class = "Lcom/lenovo/common/utils/LenovoUtils;"
target_method = "isRowVersion"
value = true

# Hide the Network acceleration entry (NetworkAccelerate app is debloated).
# getAvailabilityStatus() is a trivial `const/4; return` body shared by R8
# with other methods, so method_const_int is refused by the shared-code-item
# guard; redirect code_off to UnsupportedPreferenceController instead
# (same classes6.dex, returns 3 = unsupported/hidden).
[[op]]
kind = "method_code_redirect"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/sim/NetworkAccelerationController;"
method = "getAvailabilityStatus"
proto = "()I"
donor_class = "Lcom/lenovo/settings/widget/UnsupportedPreferenceController;"
donor_method = "getAvailabilityStatus"
donor_proto = "()I"

# Hide the pen-settings footer that advertises "Pen apps zone" (a Lenovo App
# Store page). All eight pen settings layouts gate that footer on
# @bool/is_prc and nothing else in this build reads the flag, so flipping it
# removes the row without touching any other surface.
[[op]]
kind = "resource_bool"
partition = "system"
file = "system/priv-app/PenService/PenService.apk"
resource = "is_prc"
value = false
