
name = "change-name"
description = "Show the Chinese and English market names as Legion Tab Y700 5G instead of the Wuji codename."

# text_replace is size-preserving, so "Legion Tab Y700 5G" (18 B) keeps the
# remainder of each original value as trailing spaces:

[[op]]
kind = "text_replace"
partition = "vendor"
file = "build.prop"
from = "联想AI平板 拯救者Y700无极"
to = "Legion Tab Y700 5G                "

[[op]]
kind = "text_replace"
partition = "vendor"
file = "build.prop"
from = "联想平板 拯救者Y700无极"
to = "Legion Tab Y700 5G              "

[[op]]
kind = "text_replace"
partition = "vendor"
file = "build.prop"
from = "LenovoTab LEGION Y700 Wuji"
to = "Legion Tab Y700 5G        "
