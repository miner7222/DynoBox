[[op.symbol]]
name = "intent_init"
kind = "method"
class = "Landroid/content/Intent;"
method = "<init>"
proto = "(Ljava/lang/String;)V"

[[op.replacement]]
from = "1a 02 ${ted_service:u16} 70 20 ${intent_init:u16} 20 00"
to = "0e 00 00 00 00 00 00 00 00 00"
expected = 1

[[op]]
