# Smart Optimization virus card (layout_root_virus) is visible by XML
# default with no code gate, and hiding it needs new code that does not fit
# size-preserving dex ops — collapse it in the layout binaries instead
# (height/weight + margins to zero in every variant that carries it).

[[op]]
kind = "layout_collapse"
partition = "system"
file = "system/priv-app/ZuiSecurity/ZuiSecurity.apk"
node_id = 0x7f090404
expected = 6

# Hiding the permission row leaves the last visible row of its card (privacy
# space) square at the bottom while the rounded closure went away with the
# hidden row. Swap it back to the rounded variant.

[[op]]
kind = "layout_background"
partition = "system"
file = "system/priv-app/ZuiSecurity/ZuiSecurity.apk"
node_id = 0x7f090401
drawable = 0x7f0804ab
expected = 2

# Fallback for the collapse above: if a build's layout does not match the
# collapse op (it is all-or-nothing and skips as a whole), the virus card
# would still be visible and tappable. Nop its setOnClickListener invoke
# (the iget stays, harmless) so the card then renders but does nothing when
# tapped. The setEnabled calls elsewhere keep working.

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiSecurity/ZuiSecurity.apk"
class = "Lcom/zui/safecenter/ui/SmartOptimizationActivity;"
method = "initView"
proto = "()V"

[[op.replacement]]
from = "54 60 23 87 6e 20 a3 05 60 00"
to = "54 60 23 87 00 00 00 00 00 00"
expected = 1

# Clicking any home card used to mark it "selected" (onClick ->
# setSelectedView) so its bg_home_card background stayed highlighted until
# another card was pressed. Cards whose action is inert (Anti-spam / Find My
# Tablet without their target apps) never open a pane, so the highlight just
# stuck. The split listener still re-selects the card whose pane actually
# opened, so drop only the click-time selection; the pressed-state ripple is
# untouched and now clears on release like a normal tap.

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiSecurity/ZuiSecurity.apk"
class = "Lcom/zui/safecenter/ui/MainNavigationActivity;"
method = "onClick"
proto = "(Landroid/view/View;)V"

[[op.symbol]]
name = "set_selected_view"
kind = "method"
class = "Lcom/zui/safecenter/ui/MainNavigationActivity;"
method = "setSelectedView"
proto = "(I)V"

[[op.replacement]]
from = "70 20 ${set_selected_view:u16} 02 00"
to = "00 00 00 00 00 00"
expected = 1

# ============================ AUTORUN DEFAULTS ============================
# Keep the Autostart Manager entry points, but flip its defaults to "allowed
# unless chosen otherwise". New installs are seeded enabled (the framework
# reads that state through ZuiSecurityService.getAutorunAppStatus -> 1, which
# isAllowStart allows), while an app update no longer rewrites the stored
# state and relative (app-to-app) starts default to allowed.

[[op]]
kind = "method_const_int"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/homepage/controller/TopLevelLenovoAccountPreferenceController;"
