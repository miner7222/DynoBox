# Hide the Network acceleration entry (NetworkAccelerate app is debloated).
# getAvailabilityStatus() is a trivial `const/4; return` body shared by R8
# with other methods, so method_const_int is refused by the shared-code-item
# guard; redirect code_off to UnsupportedPreferenceController instead
# (same classes6.dex, returns 3 = unsupported/hidden).

[[op]]
kind = "method_code_redirect"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/sim/NetworkAccelerationController;"
method = "getAvailabilityStatus"
proto = "()I"
donor_class = "Lcom/lenovo/settings/widget/UnsupportedPreferenceController;"
donor_method = "getAvailabilityStatus"
donor_proto = "()I"

