to = "28 20 00 00"
expected = 1

# The AOSP network pages in the same APK gate their lists through
# SubscriptionUtil.isSubscriptionVisible(). Its first check calls
# isEmbeddedSubscriptionVisible(); the built-in data SIM is a non-embedded
# LOCAL_SIM, so that gate returns true. Feed getSimSlotIndex() into the
# existing boolean check instead: slot 0 (physical) stays visible, any
# non-zero slot (the built-in slot 1) returns false. This covers
# SubscriptionRepository.getSelectableSubscriptionInfoList() and the Compose
# SimsSection without touching the telephony service.
[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/android/settings/network/SubscriptionUtil;"
method = "isSubscriptionVisible"
proto = "(Landroid/telephony/SubscriptionManager;Landroid/content/Context;Landroid/telephony/SubscriptionInfo;)Z"

[[op.symbol]]
name = "is_embedded_visible"
kind = "method"
class = "Lcom/android/settings/network/SubscriptionUtil;"
method = "isEmbeddedSubscriptionVisible"
proto = "(Landroid/telephony/SubscriptionInfo;)Z"

[[op.symbol]]
name = "get_sim_slot_index"
kind = "method"
class = "Landroid/telephony/SubscriptionInfo;"
method = "getSimSlotIndex"
proto = "()I"

[[op.replacement]]
from = "71 10 ${is_embedded_visible:u16} 05 00 0a 01"
to = "6e 10 ${get_sim_slot_index:u16} 05 00 0a 01"
expected = 1

# Call Settings keeps its own "Mark unknown number" switch (pref_mark_number),
# shown unconditionally by both the regular and compat fragments. Its checked
# state reads OperatorFunctionUtil.isEnableMarkNumber (setting
# call_setting_mark_number); pin that read to false and nop the companion
# setEnableMarkNumber write so the dead switch can never be turned on.

[[op]]
kind = "method_const_bool"
partition = "system"
file = "system/priv-app/ZuiCallSettings/ZuiCallSettings.apk"
class = "Lcom/zui/callsettings/OperatorFunctionUtil;"
method = "isEnableMarkNumber"
proto = "(Landroid/content/Context;)Z"
value = false

[[op]]
kind = "method_nop"
partition = "system"
file = "system/priv-app/ZuiCallSettings/ZuiCallSettings.apk"
class = "Lcom/zui/callsettings/OperatorFunctionUtil;"
method = "setEnableMarkNumber"
proto = "(Landroid/content/Context;Z)V"

# InCallFragment.updateAiButtonVisibility hides the whole ai_button_container
# (both AI Meeting and Live Translate pills) unless InCallPresenter.isSupportAI()
# is true. That predicate has exactly one caller and only gates this container,
# so forcing it false removes both features at the source with no other
# behavior change. The startAiMeeting/startLiveTranslate entry points are
# reachable only through these buttons, and the manifest declares no AI call
# receivers or services. Builds that dropped the AI call feature entirely
# (a ZuiDialer that carries no isSupportAI, AiMeeting, LiveTranslate, or
# ai_button resources) correctly skip this op; builds that still ship the
# feature keep landing it.

[[op]]
kind = "method_const_bool"
partition = "system"
file = "system/priv-app/ZuiDialer/ZuiDialer.apk"
class = "Lcom/android/incallui/InCallPresenter;"
method = "isSupportAI"
proto = "()Z"
value = false

# ZuiCentralSurfacesImpl.start() enables/disables the
# com.lenovoconnect.aoac.pad UniAppActivity component through
# PackageManager.setComponentEnabledSetting, which throws
# IllegalArgumentException (killing SystemUI/Keyguard) when the app was
# debloated. That block is already gated on XSystemUtil.isDevicePrc(), so
# forcing the gate false inside start() takes the existing early-out and
# the missing component is never touched. isDevicePrc() is called exactly
# once in this class, so the method-scoped force changes nothing else.

[[op]]
kind = "invoke_const_bool"
partition = "system_ext"
file = "priv-app/ZuiSystemUI/ZuiSystemUI.apk"
scan_class = "Lcom/android/systemui/statusbar/phone/ZuiCentralSurfacesImpl;"
scan_method = "start"
target_class = "Lcom/android/systemui/util/XSystemUtil;"
target_method = "isDevicePrc"
value = false

# Same crash in Settings: tapping sim_account2 calls setComponentEnabledSetting
# on com.lenovoconnect.aoac.pad OUTSIDE the try/catch (only startActivity is
# guarded), so a missing app kills Settings. Nop that one call, anchored on
# the package string; the tap then falls through to the stock
# "application_not_install" toast. The sim_account1 path in the same onClick
# is a different invoke and is untouched. Only lenovoconnect reference in
# all of ZuiSettings (smali, res, manifest surveyed).

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiHomeSettings/ZuiHomeSettings.apk"
scan_class = "Lcom/zui/font/activity/FontActivity;"
target_class = "Lcom/zui/font/util/Utilities;"
target_method = "isBusinessProject"
proto = "(Landroid/content/Context;)Z"
value = true

# A17 builds the in-game dashboard's shortcut strip from third-party app
# shortcuts, not from the feature list: FloatingMainViewNew/Right call
# AppListUtils.getSelectionForPanel(), which seeds the PRC default with
# "com.tencent.mm" and "com.tencent.mobileqq" even when neither app is
# installed (buildShortcutItems then falls back to the packaged WeChat/QQ
# labels and icons). Pin the isRow() read inside getSelectionForPanel true so
# the default becomes the empty ROW list; a selection the user saves in the
# panel still wins, so this only drops the fabricated defaults.
[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiGameHelper/ZuiGameHelper.apk"
scan_class = "Lcom/zui/game/service/util/AppListUtils;"
scan_method = "getSelectionForPanel"
target_class = "Lcom/zui/game/service/di/Settings;"
target_method = "isRow"
proto = "()Z"
value = true

# The WeChat and QQ tiles come straight from the device feature list
# (RomFeatures.keyList -> Repository.keys() -> findItemByKey), so the
# companion getKEY decoys never removed them. Repoint the two WUJI profile
# keys at "key_floating_info" instead: its item (ItemFloatingData) is dropped
# from the floating tile list by GameHelperViewController.deleteFloatingItem,
# and the original keys fall out of every isFeatureOpen() gate at the same
# time. The network-acceleration tile is deliberately left in place; the
# WeChat/QQ pairs in the other profiles are untouched.

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiGameHelper/ZuiGameHelper.apk"
class = "Lcom/zui/game/service/FeaturesBaseOnRomKt;"
method = "<clinit>"
proto = "()V"

[[op.symbol]]
name = "key_we_chat"
kind = "string"
value = "key_we_chat"

[[op.symbol]]
name = "key_qq"
kind = "string"
value = "key_qq"

[[op.symbol]]
name = "key_floating_info"
kind = "string"
value = "key_floating_info"

[[op.replacement]]
from = "1a 1a ${key_we_chat:u16} 4d 1a 08 04"
to = "1a 1a ${key_floating_info:u16} 4d 1a 08 04"
expected = 1

[[op.replacement]]
from = "1a 1a ${key_qq:u16} 4d 1a 08 0f"
to = "1a 1a ${key_floating_info:u16} 4d 1a 08 0f"
expected = 1

# The status bar draws one mobile icon per subscription from SystemUI's
# Android-16 mobile pipeline. Its SubscriptionModel carries profileClass, and
# MobileIconsInteractorImpl drops entries whose profileClass is 1 (the
# "testing" profile) behind the released filter_provisioning_network_subscriptions
# flag. The never-activated built-in data SIM sits on slot 1 and still counts
# as an active subscription, so its "no service" icon shows up next to the
# physical SIM. Feed the slot index into SubscriptionModel.profileClass instead
# of SubscriptionInfo.getProfileClass() in both mappers: slot 0 (the physical
# SIM) stays visible, slot 1 is filtered out of the icon list. profileClass is
# read nowhere else in SystemUI, so the substitution does not affect data,
# calling or the QS internet panel.
[[op]]
kind = "method_code_patch"
partition = "system_ext"
file = "priv-app/ZuiSystemUI/ZuiSystemUI.apk"
class = "Lcom/android/systemui/statusbar/pipeline/mobile/data/repository/prod/MobileConnectionsRepositoryImpl$subscriptions$1;"
method = "invokeSuspend"
proto = "(Ljava/lang/Object;)Ljava/lang/Object;"

[[op.symbol]]
name = "get_profile_class"
kind = "method"
class = "Landroid/telephony/SubscriptionInfo;"
method = "getProfileClass"
proto = "()I"

[[op.symbol]]
name = "get_sim_slot_index"
kind = "method"
class = "Landroid/telephony/SubscriptionInfo;"
method = "getSimSlotIndex"
proto = "()I"

[[op.replacement]]
from = "6e 10 ${get_profile_class:u16} 00 00 0a 07"
to = "6e 10 ${get_sim_slot_index:u16} 00 00 0a 07"
expected = 1

# Kairos keeps a second copy of the same mapper; patch it too so a build that
# switches the mobile pipeline to Kairos keeps the icon hidden.
[[op]]
kind = "method_code_patch"
partition = "system_ext"
file = "priv-app/ZuiSystemUI/ZuiSystemUI.apk"
class = "Lcom/android/systemui/statusbar/pipeline/mobile/data/repository/prod/MobileConnectionsRepositoryKairosImpl$fetchSubscriptionModels$2;"
method = "invokeSuspend"
proto = "(Ljava/lang/Object;)Ljava/lang/Object;"

[[op.symbol]]
