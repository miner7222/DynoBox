# A17 inserted a "Built-in Data SIM Card" OOBE page (BuiltinSimCardActivity)
# that LightActivity starts unconditionally. Its only forward path is
# goTianxiPage(), which requires com.lenovo.xiaotian.trigger plus DSP voice
# wakeup; on a debloated build the page's Next button does nothing and the
# wizard dead-ends. SystemNavigationActivity already has the fallback - go to
# the TianXi page when it is available, otherwise starComplete() - so pin the
# supportLight() gate to false at that one call site. The light-ring and
# built-in-SIM pages are skipped and the wizard reaches its completion page.
[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZUISetupWizardExtPRC/ZUISetupWizardExtPRC.apk"
scan_class = "Lcom/zui/setupwizard/SystemNavigationActivity;"
scan_method = "onClick"
target_class = "Lcom/zui/setupwizard/ZuiUtils;"
target_method = "supportLight"
proto = "()Z"
value = false

# ZuiTelecom binds com.ted.number.service on calls (plus rebind attempts);
# without the service every query fails gracefully (null-checked onFail
# paths), so nopping the single bind site stops all traffic.
[[op]]
kind = "method_nop"
partition = "system"
file = "system/priv-app/ZuiTelecom/ZuiTelecom.apk"
class = "Lcom/ted/number/TedServiceHelper;"
method = "bindService"
proto = "()V"

# Same bind kill for the dialer's bundled helper copy (obfuscated s5/a;
# f() holds the single bindService call site, callers null-check results).

[[op]]
kind = "method_nop"
partition = "system"
file = "system/priv-app/ZuiDialer/ZuiDialer.apk"
class = "Ls5/a;"
method = "f"
proto = "()V"

# The "Smart unknown number identification" toggle removes itself via
# removePreference when this gate is false; forcing false hides it.

[[op]]
kind = "method_const_bool"
partition = "system"
file = "system/priv-app/ZuiDialer/ZuiDialer.apk"
class = "Lm2/h;"
method = "a"
proto = "()Z"
value = false

# Same bind kill for the contacts helper copy (obfuscated d1/a).

[[op]]
kind = "method_nop"
partition = "system"
file = "system/priv-app/ZuiContacts/ZuiContacts.apk"
class = "Ld1/a;"
method = "f"
proto = "()V"

# Message embeds the same ted client (in classes2.dex) and binds the service
# for sender number recognition; nop its single bind site too. The client is
# already built to run with an unbound service (ensurePkgInstalled short
# circuit + null mPageService checks), so queries just go unanswered.

[[op]]
kind = "method_nop"
partition = "system"
file = "system/priv-app/ZuiMessage/ZuiMessage.apk"
class = "Lcom/ted/number/TedServiceHelper;"
method = "bindService"
proto = "()V"

# A17 registers the built-in data SIM (slot 1, carrier "No service") as a
# subscription even though it is never activated, and
# persist.radio.uim.remote.slot is empty, so PhoneUtils.getRemoteSlot()
# returns -1 and the existing "remote slot" filter never fires: the Messages
# settings list and the SIM selector show a second, dead SIM next to the
# physical one. The device has one physical slot, so pin the remote slot to 1;
# every getActiveSubscriptionInfoList() caller (settings items, SIM selector,
# MMS config) then drops the built-in SIM while the physical SIM keeps working.
[[op]]
kind = "method_const_int"
partition = "system"
file = "system/priv-app/ZuiMessage/ZuiMessage.apk"
class = "Lcom/android/messaging/util/PhoneUtils;"
method = "getRemoteSlot"
proto = "()I"
value = 1

# getActiveSubscriptionCount() asks SubscriptionManager for the raw active
# count, which still includes the never-activated built-in data SIM even
# though getRemoteSlot() removes it from getActiveSubscriptionInfoList().
# Messages therefore takes the multi-SIM branch in
# ApplicationSettingsFragment.onCreate and leaves the two per-SIM "Advanced"
# rows (advancedScreen1/2) in place; both open the same subscription screen
# and look dead on this one-SIM tablet. Force the single-SIM branch: it drops
# those two rows and keeps the generic Advanced row with its intent.
[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiMessage/ZuiMessage.apk"
class = "Lcom/android/messaging/ui/appsettings/ApplicationSettingsActivity$ApplicationSettingsFragment;"
method = "onCreate"
proto = "(Landroid/os/Bundle;)V"

[[op.replacement]]
from = "36 24 20 00"
to = "00 00 00 00"
expected = 1
# The dialer resolves the same built-in SIM through its own inline copy of the
# remote-slot check (g1.c methods d/i/j): each reads
# persist.radio.uim.remote.slot and falls back to -1 when the property is
# empty, so slot 1 (the never-activated built-in data SIM) survives the filter
# and appears as a second SIM in the dialpad picker, the call-back-with-SIM
# menu and the voicemail notifier. Change only that fallback constant from -1
# to 1 (const/4 vX, -0x1 -> const/4 vX, 0x1); a property value set by the
# platform still wins, and the physical SIM in slot 0 is untouched.
[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiDialer/ZuiDialer.apk"
class = "Lg1/c;"
method = "d"
proto = "(Landroid/content/Context;)Ljava/util/List;"

[[op.replacement]]
from = "12 f5"
to = "12 15"

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiDialer/ZuiDialer.apk"
class = "Lg1/c;"
method = "i"
proto = "(Ljava/lang/Integer;Landroid/content/Context;)Landroid/telecom/PhoneAccountHandle;"

[[op.replacement]]
from = "12 f4"
to = "12 14"

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiDialer/ZuiDialer.apk"
class = "Lg1/c;"
method = "j"
proto = "(Landroid/content/Context;)Ljava/util/List;"

[[op.replacement]]
from = "12 f4"
to = "12 14"

# Settings keeps two more copies of the subscription list. The ZUI
# DualCardPrefsFragment builds the default-card selector from
# getActiveSubscriptionInfoList() and gives slot 1 the "built-in data SIM"
# label before adding it to mOptionList/mSubIdList. Skip that add for slot 1
# (the physical SIM in slot 0 still takes the normal path); the selector then
# only offers the real SIM.
[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/sim/DualCardPrefsFragment;"
