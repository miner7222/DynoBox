# The compat advanced-call-settings screen still drew the "Smart unknown
# number identification" row (the earlier patch only pinned its value off).
# Its onCreate already looks the row up, so drop it from the group there:
# onCreate runs after inflation and before the hierarchy attach that walks
# the children, so the row is gone before the list is built. The framework
# variant and its activity are not declared by the manifest, so only the
# compat fragment needs it.

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiCallSettings/ZuiCallSettings.apk"
class = "Lcom/zui/callsettings/appcompat/AdvancedCallSetingsFragmentCompat;"
method = "onCreate"
proto = "(Landroid/os/Bundle;)V"

[[op.replacement]]
from = "6e 20 c4 ac 12 00 6e 10 6e ac 01 00 0c 00 71 10 f9 a9 00 00 0a 00 6e 20 c3 ac 02 00"
to = "6e 10 5f 5f 02 00 0c 00 6e 20 b0 60 20 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
expected = 1


# ZuiGameHelper flavours its per-game app lists by region: the haptic engine
# picks game_list/game_list_row plus mode_list/mode_list_row, the 4D vibration
# reader picks RomFeatures' PRC/ROW vibration array and its own PRC/ROW
# package set, and the constant lists (super resolution, frame interpolation)
# are built from PRC/ROW branches. All of them gate on Settings.isRow(); pin
# that read true inside the three readers so the ROW lists are used.

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiGameHelper/ZuiGameHelper.apk"
scan_class = "Lcom/zui/game/service/util/HapticUtils;"
scan_method = "openHapticEffect"
target_class = "Lcom/zui/game/service/di/Settings;"
target_method = "isRow"
proto = "()Z"
value = true

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiGameHelper/ZuiGameHelper.apk"
scan_class = "Lcom/zui/game/service/vibrate/VibrationToolKt;"
scan_method = "isGameSupport4dVibration"
target_class = "Lcom/zui/game/service/di/Settings;"
target_method = "isRow"
proto = "()Z"
value = true

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiGameHelper/ZuiGameHelper.apk"
scan_class = "Lcom/zui/game/service/util/ConstValueKt;"
scan_method = "<clinit>"
target_class = "Lcom/zui/game/service/di/Settings;"
target_method = "isRow"
proto = "()Z"
value = true


# NetworkAccelerator: keep the WiFi+data dual-network feature only and stop
# the Lenovo activation from gating it. The game/meeting rows and the whole
# VPN stack stay inert: both VPN start paths are nop'ed, the activation and
# expiry readers are pinned (activated, never expired), the server calls are
# nop'ed so nothing is fetched or shown, and updateState's enable calls now
# pass the already-zero register (v2) for the two VPN rows instead of v1, so
# the rows render disabled instead of usable.

[[op]]
kind = "method_nop"
partition = "system"
file = "system/priv-app/NetworkAccelerate/NetworkAccelerate.apk"
class = "Lcom/android/networkaccelerate/NetworkAccelService;"
method = "doStartVpn"
proto = "()V"

[[op]]
kind = "method_nop"
partition = "system"
file = "system/priv-app/NetworkAccelerate/NetworkAccelerate.apk"
class = "Lcom/android/networkaccelerate/NetworkAccelService;"
method = "startVpnWhenEnterMeeting"
proto = "(Ljava/lang/String;)V"

[[op]]
kind = "method_const_bool"
partition = "system"
file = "system/priv-app/NetworkAccelerate/NetworkAccelerate.apk"
class = "Lcom/android/networkaccelerate/SettingsFragment;"
method = "isDeviceActivated"
proto = "()Z"
value = true

[[op]]
kind = "method_const_bool"
partition = "system"
file = "system/priv-app/NetworkAccelerate/NetworkAccelerate.apk"
class = "Lcom/android/networkaccelerate/SettingsFragment;"
method = "isDeviceExpired"
proto = "()Z"
value = false

[[op]]
kind = "method_nop"
partition = "system"
file = "system/priv-app/NetworkAccelerate/NetworkAccelerate.apk"
class = "Lcom/android/networkaccelerate/SettingsFragment;"
method = "queryDeviceInfo"
proto = "()V"

[[op]]
kind = "method_nop"
partition = "system"
file = "system/priv-app/NetworkAccelerate/NetworkAccelerate.apk"
class = "Lcom/android/networkaccelerate/SettingsFragment;"
method = "activateDevice"
proto = "(Landroid/content/Context;)V"

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/NetworkAccelerate/NetworkAccelerate.apk"
class = "Lcom/android/networkaccelerate/SettingsFragment;"
method = "updateState"
proto = "()V"

[[op.symbol]]
name = "pref_set_enabled"
kind = "method"
class = "Landroidx/preference/Preference;"
method = "setEnabled"
proto = "(Z)V"

[[op.replacement]]
from = "6e 20 ${pref_set_enabled:u16} 10 00"
to = "6e 20 ${pref_set_enabled:u16} 20 00"
expected = 2

# The disabled rows must not advertise a state either: updateState() still reads
# the two per-feature switches and writes "turn on" / "turn off" into each row's
# summary once the dual-network switch is on, so drop both setSummary calls.

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/NetworkAccelerate/NetworkAccelerate.apk"
class = "Lcom/android/networkaccelerate/SettingsFragment;"
method = "updateState"
proto = "()V"

[[op.symbol]]
name = "pref_set_summary"
kind = "method"
class = "Landroidx/preference/Preference;"
method = "setSummary"
proto = "(I)V"

[[op.replacement]]
from = "6e 20 ${pref_set_summary:u16} 01 00"
to = "00 00 00 00 00 00"
expected = 1

[[op.replacement]]
from = "6e 20 ${pref_set_summary:u16} 35 00"
to = "00 00 00 00 00 00"
expected = 1


# The launcher's cloud-switch row is kept only while the Lenovo cloud folder
# service is online; pin that read false inside the settings fragment so the
# row is removed like the other unsupported ones.

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiLauncher/ZuiLauncher.apk"
scan_class = "Lcom/zui/launcher/settings/ZuiLauncherFragment;"
scan_method = "N"
target_class = "Lcom/zui/launcher/cloudfolder/CloudUtils;"
target_method = "isCloudFolderOnLine"
proto = "(Landroid/content/Context;)Z"
value = false

# ===========================================================================
# ZUXOS 2.5.10.068 (Android 17 / TB324ZC) alternates.
# A17 moved the ZUI launcher utilities into com.zui.launcher.UtilitiesZux,
# renamed the launcher-settings handlers and the freeform/contacts helpers,
# and changed several register allocations. Each alternate below matches one
# A17 shape only; the original ops stay for the 165/187/223/A16 builds.
# ===========================================================================

[[op]]
kind = "method_const_bool"
partition = "system"
file = "system/priv-app/ZuiLauncher/ZuiLauncher.apk"
class = "Lcom/zui/launcher/UtilitiesZux;"
method = "isZuiRow"
value = true

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiLauncher/ZuiLauncher.apk"
scan_class = "Lcom/android/launcher3/icons/BitmapInfo;"
scan_method = "getBadgeType"
target_class = "Lcom/android/launcher3/icons/GraphicsUtils;"
target_method = "isZuiRow"
value = false

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiLauncher/ZuiLauncher.apk"
scan_class = "Lcom/zui/launcher/settings/ZuiLauncherFragment;"
scan_method = "J"
target_class = "Lcom/zui/launcher/cloudfolder/CloudUtils;"
target_method = "isCloudFolderOnLine"
proto = "(Landroid/content/Context;)Z"
value = false

# A17 renamed the contacts helper method to e()V, but A16 also has an
# unrelated e()V. Gate the patch on the Ted service literal so it only
# rewrites the A17 body (A16 keeps using the original f()V op above).
[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiContacts/ZuiContacts.apk"
class = "Ld1/a;"
method = "e"
proto = "()V"

[[op.symbol]]
name = "ted_service"
