# APN editor: shipped (edited==0) carriers are read-only on PRC. Nop the gate
# that consumes the ZUI list's DISABLE_EDITOR extra, and force the onCreate
# "edited==1" branch so user_editable=0 / read-only-type rows stay editable.
# Both targets live in the image's ZuiSettings and have unshared code items;
# saving writes edited=1, which the provider never filters.
[[op]]
kind = "method_nop"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/android/settings/network/apn/ApnEditor;"
method = "disableFieldForRowandPrc"

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/android/settings/network/apn/ApnEditor;"
method = "onCreate"
proto = "(Landroid/os/Bundle;)V"

[[op.replacement]]
from = "33 30 04 00 01 30 28 02 01 10"
to = "33 30 04 00 01 30 28 02 01 30"
expected = 1


# Launcher settings: the auto-reorder row is removed on commercial projects
# and the Blue Point row only when the config feature is absent, so pin both
# gates open.
#
# The layout dialog lists only the profiles whose `canBeShown` column the grid
# provider reports true, which on the pad profile is 8x4 alone; every other
# grid (6x4, 6x5, 5x4 and the learning 4x6 profile) stays hidden behind
# canBeShown="false" in res/xml/device_profiles_row_new_rotation. The fragment
# reads that column as "true".equalsIgnoreCase(cursor.getString(canBeShown)) and
# then skips the row when false, so force the comparison result to true: every
# n x n profile is listed and the "custom" row keeps the stock fragment-level
# filter that drops it by name.

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiLauncher/ZuiLauncher.apk"
scan_class = "Lcom/zui/launcher/settings/ZuiLauncherFragment;"
scan_method = "L"
target_class = "Lcom/zui/launcher/utils/TaskbarUtilities;"
target_method = "isCommercialProject"
proto = "()Z"
value = false

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiLauncher/ZuiLauncher.apk"
scan_class = "Lcom/zui/launcher/settings/ZuiLauncherFragment;"
scan_method = "M"
target_class = "Lcom/zui/launcher/BluePoint;"
target_method = "hasBluePointFunction"
proto = "(Landroid/content/Context;)Z"
value = true

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiLauncher/ZuiLauncher.apk"
class = "Lcom/android/launcher3/Utilities;"
method = "queryGridOptions"
proto = "(Landroid/content/Context;)Ljava/util/List;"

[[op.symbol]]
name = "cursor_get_string"
kind = "method"
class = "Landroid/database/Cursor;"
method = "getString"
proto = "(I)Ljava/lang/String;"

[[op.symbol]]
name = "string_equals_ignore_case"
kind = "method"
class = "Ljava/lang/String;"
method = "equalsIgnoreCase"
proto = "(Ljava/lang/String;)Z"

[[op.replacement]]
from = "72 20 ${cursor_get_string:u16} 57 00 0c 08 6e 20 ${string_equals_ignore_case:u16} 80 00 0a 08"
to = "72 20 ${cursor_get_string:u16} 57 00 0c 08 6e 20 ${string_equals_ignore_case:u16} 80 00 12 18"
expected = 1

# Keyboard display names: with isRowProduct false the parser takes the PRC
# marketing names (marketing_name_prc_consumer / marketing_name_prc_commerical)
# plus the "磁吸键盘" suffix when the config asks for the market name, and the
# input service labels the Olympia keyboard with the PRC strings. Each of the
# three classes initializes its own isRowProduct static from
# SystemProperties.get("ro.config.lgsi.region").equals("row"); that comparison
# is the only Object.equals call in each static initializer, so force the
# result to true and leave the region prop alone.

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/framework/services.jar"
scan_class = "Lcom/zui/server/input/keyboard/key/utils/KeyboardConfigParser;"
scan_method = "<clinit>"
target_class = "Ljava/lang/Object;"
target_method = "equals"
proto = "(Ljava/lang/Object;)Z"
value = true

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/framework/services.jar"
scan_class = "Lcom/zui/server/input/keyboard/key/utils/KeyboardConstants;"
scan_method = "<clinit>"
target_class = "Ljava/lang/Object;"
target_method = "equals"
proto = "(Ljava/lang/Object;)Z"
value = true

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/framework/services.jar"
scan_class = "Lcom/android/server/input/InputManagerServiceDelegate;"
scan_method = "<clinit>"
target_class = "Ljava/lang/Object;"
target_method = "equals"
proto = "(Ljava/lang/Object;)Z"
value = true

# OomAdjuster seeds isPrcSku from ro.config.lgsi.region and its only reader is
# getZuiFreezePolicy, which returns true (apply the ZUI freeze policy) only for
# a PRC consumer build that is not in test mode and owns the top app. Force the
# static initializer comparison to false so the policy never selects a process;
# the field has no other reader in the jar.

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/framework/services.jar"
scan_class = "Lcom/android/server/am/OomAdjuster;"
scan_method = "<clinit>"
target_class = "Ljava/lang/Object;"
target_method = "equals"
proto = "(Ljava/lang/Object;)Z"
value = false

# Notification effect colors: the manager picks its effect-color set in
# onBootPhase and the only thing separating the PRC set (WeChat green, QQ
# amber) from the ROW set (Teams purple, Messenger white) is the isROW field,
# which the constructor seeds from ro.config.zui.region. Force that one read in
# onBootPhase to true so the ROW set is selected; the field is written once and
# read nowhere else in the jar.

[[op]]
kind = "field_const_bool"
partition = "system"
file = "system/framework/services.jar"
scan_class = "Lcom/android/server/notification/NotificationManagerService;"
scan_method = "onBootPhase"
target_class = "Lcom/android/server/notification/NotificationManagerService;"
target_field = "isROW"
value = true

# One Vision compat list: readXml branches on the OvcFeatureFlags statics, so
# the PRC build loads ov_common_prc_packages and the ROW build loads
# ov_common_row_packages. Flip both static reads inside this method alone so
# the ROW branch runs; the flags keep their stock values for every other
# consumer.

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/framework/services.jar"
class = "Lcom/android/server/wm/OvCommonCompatConfigs;"
method = "readXml"
proto = "()V"

[[op.symbol]]
name = "is_prc"
kind = "field"
class = "Landroid/util/OvcFeatureFlags;"
field = "isPrc"
ty = "Z"

[[op.symbol]]
name = "is_row"
kind = "field"
class = "Landroid/util/OvcFeatureFlags;"
field = "isRow"
ty = "Z"

[[op.replacement]]
from = "63 00 ${is_prc:u16}"
to = "12 00 00 00"
expected = 1

[[op.replacement]]
from = "63 00 ${is_row:u16}"
to = "12 10 00 00"
expected = 1

# The floating assistant's mode button cycles 4 -> 1 -> 2 -> 16 only while a
# cooling fan answers the HID handshake (getNextMode appends the 16 entry only
# when isHidDeviceConnected() is true), so a fan-less device can never reach
# super god mode from the floating window. Nop the skip branch in the portrait
# and landscape views so the add(16) below always runs. The landscape view
# assembles two mode lists (PC-mode games and the rest), each with its own
# identical gate, so that op expects two sites.
#
# This ladder op is the only super god path that matters on newer builds:
# they dropped key_super_god_mode (and key_voice_ball_mode) from the WUJI
# RomFeatures keyList and moved super god to this mode cycle — power save
# -> balanced -> performance -> super god. The dead ItemSuperGodMode
# unlock machinery (the onClick fan-guard nop, the panel first-time flag
# pins and the Settings.supportSuperGogMode pin) was removed from this
# file on purpose: findItemByKey can never build the item without its key,
# and pinning the support flag only woke a latent vendor crash —
# onGameAppExit gated the unconditional releaseSuperGodListener on it,
# which lazily builds the item and threw "unknown key" before
# hideGameHelper/stopSelf could run, leaving the handle and panel stuck
# over every app.

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiGameHelper/ZuiGameHelper.apk"
class = "Lcom/zui/game/service/ui/view/FloatingMainViewNew;"
method = "getNextMode"
proto = "(I)I"

[[op.symbol]]
name = "is_hid_connected"
kind = "method"
class = "Lcom/zui/game/service/ui/view/FloatingMainViewNew;"
method = "isHidDeviceConnected"
proto = "()Z"

[[op.symbol]]
name = "integer_value_of"
kind = "method"
class = "Ljava/lang/Integer;"
method = "valueOf"
proto = "(I)Ljava/lang/Integer;"

[[op.symbol]]
name = "list_add"
kind = "method"
class = "Ljava/util/List;"
method = "add"
proto = "(Ljava/lang/Object;)Z"

[[op.symbol]]
name = "settings_get"
kind = "method"
class = "Lcom/zui/game/service/di/SettingsKt;"
method = "getSettings"
proto = "()Lcom/zui/game/service/di/Settings;"

[[op.symbol]]
name = "support_perf"
kind = "method"
class = "Lcom/zui/game/service/di/Settings;"
method = "getSupportPerformanceMode"
proto = "()Z"

[[op.replacement]]
from = "70 10 ${is_hid_connected:u16} 03 00 0a 01 38 01 0b 00"
to = "70 10 ${is_hid_connected:u16} 03 00 0a 01 00 00 00 00"
expected = 1

[[op.replacement]]
from = "12 11 71 10 ${integer_value_of:u16} 01 00 0c 02 72 20 ${list_add:u16} 20 00 12 22 71 10 ${integer_value_of:u16} 02 00 0c 02 72 20 ${list_add:u16} 20 00 71 00 ${settings_get:u16} 00 00 0c 02 6e 10 ${support_perf:u16} 02 00 0a 02 39 02 0a 00 12 42 71 10 ${integer_value_of:u16} 02 00 0c 02 72 20 ${list_add:u16} 20 00"
to = "71 00 ${settings_get:u16} 00 00 0c 02 6e 10 ${support_perf:u16} 02 00 0a 02 39 02 0a 00 12 42 71 10 ${integer_value_of:u16} 02 00 0c 02 72 20 ${list_add:u16} 20 00 12 11 71 10 ${integer_value_of:u16} 01 00 0c 02 72 20 ${list_add:u16} 20 00 12 22 71 10 ${integer_value_of:u16} 02 00 0c 02 72 20 ${list_add:u16} 20 00"
expected = 1

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiGameHelper/ZuiGameHelper.apk"
class = "Lcom/zui/game/service/ui/view/FloatingMainViewRight;"
method = "getNextMode"
proto = "(I)I"

[[op.symbol]]
name = "is_hid_connected"
kind = "method"
class = "Lcom/zui/game/service/ui/view/FloatingMainViewRight;"
method = "isHidDeviceConnected"
proto = "()Z"

[[op.symbol]]
name = "integer_value_of"
kind = "method"
class = "Ljava/lang/Integer;"
method = "valueOf"
proto = "(I)Ljava/lang/Integer;"

[[op.symbol]]
name = "list_add"
kind = "method"
class = "Ljava/util/List;"
method = "add"
proto = "(Ljava/lang/Object;)Z"

[[op.symbol]]
name = "settings_get"
kind = "method"
class = "Lcom/zui/game/service/di/SettingsKt;"
method = "getSettings"
proto = "()Lcom/zui/game/service/di/Settings;"

[[op.symbol]]
name = "support_perf"
kind = "method"
class = "Lcom/zui/game/service/di/Settings;"
method = "getSupportPerformanceMode"
proto = "()Z"

[[op.replacement]]
from = "70 10 ${is_hid_connected:u16} 05 00 0a 01 38 01 05 00"
to = "70 10 ${is_hid_connected:u16} 05 00 0a 01 00 00 00 00"
expected = 2

[[op.replacement]]
from = "12 11 71 10 ${integer_value_of:u16} 01 00 0c 02 72 20 ${list_add:u16} 20 00 71 00 ${settings_get:u16} 00 00 0c 02 6e 10 ${support_perf:u16} 02 00 0a 02 39 02 0a 00 12 42 71 10 ${integer_value_of:u16} 02 00 0c 02 72 20 ${list_add:u16} 20 00 12 22 71 10 ${integer_value_of:u16} 02 00 0c 02 72 20 ${list_add:u16} 20 00"
to = "71 00 ${settings_get:u16} 00 00 0c 02 6e 10 ${support_perf:u16} 02 00 0a 02 39 02 0a 00 12 42 71 10 ${integer_value_of:u16} 02 00 0c 02 72 20 ${list_add:u16} 20 00 12 11 71 10 ${integer_value_of:u16} 01 00 0c 02 72 20 ${list_add:u16} 20 00 12 22 71 10 ${integer_value_of:u16} 02 00 0c 02 72 20 ${list_add:u16} 20 00"
expected = 1

[[op]]
kind = "permission_protection"
partition = "system"
file = "system/framework/framework-res.apk"
permission = "zui.permission.ACCESS_THEME_MANAGER"
protection_level = 0

[[op]]
kind = "permission_protection"
partition = "system"
file = "system/framework/framework-res.apk"
permission = "zui.permission.READ_THEMES"
protection_level = 0

[[op]]
kind = "permission_protection"
partition = "system"
file = "system/framework/framework-res.apk"
permission = "zui.permission.WRITE_THEMES"
protection_level = 0
# ===========================================================================
# ZUXOS 2.5.10.068 (Android 17 / TB324ZC) alternates.
# ===========================================================================

[[op]]
kind = "invoke_const_bool"
partition = "system_ext"
file = "priv-app/ZuiSystemUI/ZuiSystemUI.apk"
scan_class = "Lcom/android/systemui/assist/AssistManager;"
target_class = "Lcom/android/systemui/utils/XSystemUtil;"
target_method = "isDeviceRow"
value = true

# A17 now restores the Dolby choice from recordDolbySwitchStatusWidthHeadSet
# on connect but still writes 0 on disconnect, so nop the disconnect write.
# Register shape: move-result-object v0 / putInt {v0, v4, v3}.
[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/framework/services.jar"
class = "Lcom/android/server/audio/AudioService;"
method = "setWiredDeviceConnectionState"
proto = "(Landroid/media/AudioDeviceAttributes;ILjava/lang/String;)V"

[[op.symbol]]
name = "put_int"
kind = "method"
class = "Landroid/provider/Settings$Global;"
method = "putInt"
proto = "(Landroid/content/ContentResolver;Ljava/lang/String;I)Z"

[[op.replacement]]
from = "0c 00 71 30 ${put_int:u16} 40 03"
to = "0c 00 00 00 00 00 00 00"
expected = 1

# The "voice_interaction_service" literal outgrew the 16-bit string pool on
# A17 (const-string/jumbo), so swap the u32 operand instead.
[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/framework/services.jar"
class = "Lcom/android/server/voiceinteraction/VoiceInteractionManagerService$VoiceInteractionManagerServiceStub;"
method = "switchImplementationIfNeededNoTracingLocked"
proto = "(Z)V"

[[op.symbol]]
name = "voice_interaction_service"
kind = "string"
value = "voice_interaction_service"

[[op.symbol]]
name = "assistant"
kind = "string"
value = "assistant"

[[op.replacement]]
from = "1b 01 ${voice_interaction_service:u32}"
to = "1b 01 ${assistant:u32}"
expected = 1

# A17 renamed the obfuscated launcher-settings handlers: L/M/N -> H/I/J.
# isCommercialProject also moved to FeatureFlagsExt (the TaskbarUtilities
# helper is gone from this call site). A17 also inverted both gate
# polarities: H removes the auto-reorder row when isCommercialProject is
# false, and I removes the blue-point row when hasBluePointFunction is true.
# Pin them to true/false respectively (opposite of the A16 L/M ops).
[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiLauncher/ZuiLauncher.apk"
scan_class = "Lcom/zui/launcher/settings/ZuiLauncherFragment;"
scan_method = "H"
target_class = "Lcom/zui/launcher/config/FeatureFlagsExt;"
target_method = "isCommercialProject"
proto = "()Z"
value = true

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiLauncher/ZuiLauncher.apk"
scan_class = "Lcom/zui/launcher/settings/ZuiLauncherFragment;"
scan_method = "I"
target_class = "Lcom/zui/launcher/BluePoint;"
target_method = "hasBluePointFunction"
proto = "(Landroid/content/Context;)Z"
value = false

# queryGridOptions moved with the other ZUI helpers into UtilitiesZux; the
# body keeps the same cursor/equalsIgnoreCase shape.
[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiLauncher/ZuiLauncher.apk"
class = "Lcom/zui/launcher/UtilitiesZux;"
method = "queryGridOptions"
proto = "(Landroid/content/Context;)Ljava/util/List;"

[[op.symbol]]
name = "cursor_get_string"
kind = "method"
class = "Landroid/database/Cursor;"
method = "getString"
proto = "(I)Ljava/lang/String;"

[[op.symbol]]
name = "string_equals_ignore_case"
kind = "method"
class = "Ljava/lang/String;"
method = "equalsIgnoreCase"
proto = "(Ljava/lang/String;)Z"

[[op.replacement]]
from = "72 20 ${cursor_get_string:u16} 57 00 0c 08 6e 20 ${string_equals_ignore_case:u16} 80 00 0a 08"
to = "72 20 ${cursor_get_string:u16} 57 00 0c 08 6e 20 ${string_equals_ignore_case:u16} 80 00 12 18"
expected = 1

# A17 keeps the getNextMode bodies but moves the HID result to v3.
[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiGameHelper/ZuiGameHelper.apk"
class = "Lcom/zui/game/service/ui/view/FloatingMainViewNew;"
method = "getNextMode"
proto = "(I)I"

[[op.symbol]]
name = "is_hid_connected"
kind = "method"
class = "Lcom/zui/game/service/ui/view/FloatingMainViewNew;"
method = "isHidDeviceConnected"
proto = "()Z"

[[op.replacement]]
from = "70 10 ${is_hid_connected:u16} 03 00 0a 03 38 03 0b 00"
to = "70 10 ${is_hid_connected:u16} 03 00 0a 03 00 00 00 00"
expected = 1

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiGameHelper/ZuiGameHelper.apk"
class = "Lcom/zui/game/service/ui/view/FloatingMainViewRight;"
method = "getNextMode"
proto = "(I)I"

[[op.symbol]]
name = "is_hid_connected"
kind = "method"
class = "Lcom/zui/game/service/ui/view/FloatingMainViewRight;"
method = "isHidDeviceConnected"
proto = "()Z"

[[op.replacement]]
from = "70 10 ${is_hid_connected:u16} 03 00 0a 03 38 03 0b 00"
to = "70 10 ${is_hid_connected:u16} 03 00 0a 03 00 00 00 00"
expected = 1

# A17 dropped the OneTimeInitializer comment block that the A16 op consumed.
# Insert CONTEXTUAL_SEARCH + GEMINI_EXPERIENCE by consuming two comments that
# only exist in the A17 file (MOJITOX notes), keeping the file size unchanged.
[[op]]
kind = "text_replace"
partition = "product"
file = "etc/sysconfig/google.xml"
from = "<!-- [MOJITOX-1662] The allow-association configuration for PCS is not required in Android 17. -->"
to = "<feature name=\"com.google.android.feature.CONTEXTUAL_SEARCH\" />\n    <!--                       -->"

[[op]]
kind = "text_replace"
partition = "product"
file = "etc/sysconfig/google.xml"
from = "<!-- <allow-association target=\"com.google.android.as.oss\" allowed=\"com.google.android.odad\" /> -->"
to = "<feature name=\"com.google.android.feature.GEMINI_EXPERIENCE\" />\n    <!--                        -->"

# --- A17 PRC/ROW gate flips ------------------------------------------------
# The A17 gate survey (a17_prc_row_gate_report.md) found settings and tiles
# that the PRC build hides behind a region predicate even though the feature
# itself is present. All of these are per-call-site pins; no global region
# property is touched.

# Sound > Alarm sound is removed on PRC because isAvailable() is literally
# `return isRowVersion()`.
[[op]]
kind = "method_const_bool"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/android/settings/notification/AlarmRingtonePreferenceController;"
method = "isAvailable"
proto = "()Z"
value = true

# Focus mode / notification-free entry (reads DISTURB_SETTINGS_SWITCH) is
# gated to 3 on PRC.
[[op]]
kind = "method_const_int"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/zen/NotifiFreePreferenceController;"
method = "getAvailabilityStatus"
proto = "()I"
value = 0

# Tapping the date opens com.zui.calendar on PRC; on ROW it opens Google
# Calendar when installed and falls back to an unaddressed VIEW intent.
[[op]]
kind = "invoke_const_bool"
partition = "system_ext"
file = "priv-app/ZuiSystemUI/ZuiSystemUI.apk"
scan_class = "Lcom/android/systemui/shade/ShadeHeaderController$onViewAttached$2;"
scan_method = "onClick"
target_class = "Lcom/android/systemui/utils/XSystemUtil;"
target_method = "isDeviceRow"
proto = "()Z"
value = true

# Three-finger tap offers "Launch Gemini" only on ROW; getDefaultKey also
# prefers it when com.google.android.apps.bard is installed.
[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
scan_class = "Lcom/lenovo/settings/keyboard/ThreeFingerTapDetailFragment;"
scan_method = "getCandidates"
target_class = "Lcom/lenovo/common/utils/LenovoUtils;"
target_method = "isRowVersion"
proto = "()Z"
value = true

[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
scan_class = "Lcom/lenovo/settings/keyboard/ThreeFingerTapDetailFragment;"
scan_method = "getDefaultKey"
target_class = "Lcom/lenovo/common/utils/LenovoUtils;"
target_method = "isRowVersion"
proto = "()Z"
value = true

# The ROW branch adds MIC_TOGGLE/CAMERA_TOGGLE/LIVE_CAPTION candidates; the
# PRC branch keeps privacy-shield and AI live subtitles, so pinning row true
# yields the union rather than replacing the PRC entries.
[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
scan_class = "Lcom/lenovo/settings/keyboard/AppQuickSettingsFragment;"
scan_method = "buildCandidates"
target_class = "Lcom/lenovo/common/utils/LenovoUtils;"
target_method = "isRowVersion"
proto = "()Z"
value = true

# Same three candidates for the pen tail button.
[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/PenService/PenService.apk"
scan_class = "Lcom/lenovo/pen/bt/ui/tail/QuickSettingDataManager;"
scan_method = "buildCandidates"
target_class = "Lcom/lenovo/pen/cap/util/SystemProps;"
target_method = "isRow"
proto = "()Z"
value = true

# Pen Circle to Search is `isRow && PenConfig.isFeatureCircleToSearchEnable`.
[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/PenService/PenService.apk"
scan_class = "Lcom/lenovo/pen/cap/util/Features;"
scan_method = "isSupportCircleToSearch"
target_class = "Lcom/lenovo/pen/cap/util/SystemProps;"
target_method = "isRow"
proto = "()Z"
value = true

# Special app access > Turn screen on. Its stock 10-insn body is
# deduplicated with ZuiPowerSavingWarningController.getAvailabilityStatus, so
# forcing the body would also expose the (unwanted) power-saving warning.
# Redirect only this encoded method to an existing same-shape availability
# method that returns 0 on PRC (the overheat row); the shared code item and
# the warning controller stay untouched.
[[op]]
kind = "method_code_redirect"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/applications/specialaccess/TurnScreenOnPreferenceController;"
method = "getAvailabilityStatus"
proto = "()I"
donor_class = "Lcom/lenovo/settings/battery/ZuiBatteryOverheatPreferenceController;"
donor_method = "getAvailabilityStatus"
donor_proto = "()I"

# The ROW gate flip makes the taskbar search-bar row available on this PRC
# build, but the bar renders squashed at this taskbar height and Google
# Search is absent, so keep the controller unavailable.
[[op]]
kind = "method_const_int"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/system/taskbar/TaskbarSearchBarController;"
method = "getAvailabilityStatus"
proto = "()I"
value = 3

# Lab focus mode participates in two OR chains that keep the Lab and
# Advanced entries visible when every other lab feature is off. The
# notification_free row itself is handled by NotifiFreePreferenceController.
[[op]]
kind = "method_const_bool"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/advancedfeatures/LabFeaturePreferenceController;"
method = "isFocusModeEnable"
proto = "()Z"
value = true

[[op]]
kind = "method_const_bool"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
class = "Lcom/lenovo/settings/homepage/controller/TopLevelAdvancedPreferenceController;"
method = "isFocusModeEnable"
proto = "()Z"
value = true

# Standby power optimization: ZuiNightPowerSave is already true in the A17
# LGSI set and the build is consumer, so only the isPrc term blocks it.
# Pin that one read; the commercial and LGSI checks stay intact.
[[op]]
kind = "invoke_const_bool"
partition = "system"
file = "system/priv-app/ZuiSettings/ZuiSettings.apk"
scan_class = "Lcom/lenovo/settings/battery/ZuiPowerSavingDuringSleepController;"
scan_method = "isSupport"
target_class = "Lcom/lenovo/common/utils/LenovoUtils;"
target_method = "isPrcVersion"
proto = "()Z"
value = false

# The A17 GPP list still ships the Qualcomm placeholder entry and does not
# carry the global builds of Wild Rift and Teamfight Tactics, even though the
# CN clients (com.tencent.lolm / com.tencent.jkchess) are listed. GPP entries
# live one per line and the patcher is size-preserving, so use the dead
# placeholder line plus its format comment as the slot: the two global
# packages replace them with no trailing spaces on a package line.
[[op]]
kind = "text_replace"
partition = "system"
file = "system/etc/gpp_app_list"
from = "# game package name, there must be no extra spaces at the end of each line\ncom.YourCompany.srgb\n"
to = "# DynoBox global games     \ncom.riotgames.league.wildrift\ncom.riotgames.league.teamfighttactics\n"
