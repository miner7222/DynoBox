
name = "unlock-common"
description = "Unlock PRC-gated behavior and locked rows: locales/region UI, Wi-Fi region, Circle to Search, Google services, battery health, account entry, autorun and relative starts, CCS, Dolby switch and ZMC quick kill."

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/priv-app/ZuiSecurity/ZuiSecurity.apk"
class = "Lcom/lenovo/performance/autorun/utils/AutoRunDataUtils;"
method = "appInfoConvertToAutoRunItem"
proto = "(Lcom/lenovo/performance/autorun/beans/AppInfo;)Lcom/lenovo/performance/autorun/AutoRunItem;"

[[op.replacement]]
from = "12 02"
to = "12 12"
expected = 1

# processAdd() calls updateEntryIntoDb() for packages that already have a row;
# drop that call so updating an app keeps its stored autorun on/off state.

[[op]]
kind = "nop_invoke"
partition = "system"
file = "system/priv-app/ZuiSecurity/ZuiSecurity.apk"
scan_class = "Lcom/lenovo/performance/autorun/services/AutoRunPkgReceiver;"
scan_method = "processAdd"
target_class = "Lcom/lenovo/performance/autorun/AutoRunDataLayerManager;"
target_method = "updateEntryIntoDb"
proto = "(Lcom/lenovo/performance/autorun/AutoRunItem;)V"
anchor_string = "InstallApp "

# getRelativeAppStatus() returns 0 for pairs the user never chose, which
# isAllowStart treats as "blocked unless the caller is top"; seed the default
# with 1 so unlisted pairs are allowed. An explicit block (2) still wins.

[[op]]
kind = "method_code_patch"
partition = "system"
file = "system/framework/services.jar"
class = "Lcom/android/server/ZuiSecurityService$ZuiSecurityServiceBinder;"
method = "getRelativeAppStatus"
proto = "(Ljava/lang/String;Ljava/lang/String;)I"

[[op.replacement]]
from = "12 00"
to = "12 10"
expected = 1

